# Copy to .env and replace every CHANGE_ME. .env is git-ignored.

ENVIRONMENT=development

# App role (insert/select only on audit_log). Migrations run as the owner role.
DATABASE_URL=postgresql+psycopg://loanrag_app:CHANGE_ME_APP_DB_PASSWORD@localhost:5432/loanrag
MIGRATION_DATABASE_URL=postgresql+psycopg://loanrag_owner:CHANGE_ME_OWNER_DB_PASSWORD@localhost:5432/loanrag
APP_DB_ROLE=loanrag_app
POSTGRES_OWNER_PASSWORD=CHANGE_ME_OWNER_DB_PASSWORD
APP_DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD

# Auth: use JWKS_URL with Keycloak, or JWT_PUBLIC_KEY_PATH with mint-token (dev/tests only).
JWKS_URL=http://localhost:8080/realms/loanrag/protocol/openid-connect/certs
JWT_PUBLIC_KEY_PATH=
JWT_PRIVATE_KEY_PATH=./keys/test_private.pem
JWT_ISSUER=http://localhost:8080/realms/loanrag
JWT_AUDIENCE=loanrag-api

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN
DEV_USER_PASSWORD=CHANGE_ME_DEV_USER_PASSWORD

AUDIT_HMAC_KEY=CHANGE_ME_LONG_RANDOM_HEX

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FAISS_INDEX_PATH=./data/index.faiss
DOCUMENT_STORE_PATH=./data/documents

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
HOSTED_LLM_BASE_URL=https://api.groq.com/openai/v1
HOSTED_LLM_MODEL=CHANGE_ME_MODEL_NAME
HOSTED_LLM_API_KEY=CHANGE_ME_HOSTED_KEY

EVAL_REQUESTS_PER_MINUTE=20
RETRIEVAL_N_START=50
RETRIEVAL_N_MAX=800
TOP_K_DEFAULT=6
RATE_LIMIT_PER_MINUTE=30
